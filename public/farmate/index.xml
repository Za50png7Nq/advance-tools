      <title>Id Card- Gajab Tools</title>
      <link>http://localhost:1313/fpb-identity-card/</link>
      <pubDate>Wed, 05 Aug 2026 15:52:59 +0530</pubDate>
      <guid>http://localhost:1313/fpb-identity-card/</guid>
      <description>&lt;!DOCTYPE html&gt;&#xD;&#xA;&lt;html&gt;&#xD;&#xA;&lt;head&gt;&#xD;&#xA;    &lt;meta name=&#34;viewport&#34; content=&#34;width=device-width, initial-scale=1&#34;&gt;&#xD;&#xA;&lt;link rel=&#34;stylesheet&#34; href=&#34;https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css&#34;&gt;&#xD;&#xA;  &lt;title&gt; FPB Identity Card&lt;/title&gt;&#xD;&#xA;  &lt;script&gt;&#xD;&#xA;        function checkAccount() {&#xD;&#xA;            var account = document.getElementById(&#39;account&#39;).value;&#xD;&#xA;            var confirmAccount = document.getElementById(&#39;confirm_account&#39;).value;&#xD;&#xA;&#xD;&#xA;            if (account !== confirmAccount) {&#xD;&#xA;                alert(&#34;Accounts do not match!&#34;);&#xD;&#xA;                return false;&#xD;&#xA;            }&#xD;&#xA;            return true;&#xD;&#xA;        }&#xD;&#xA;    &lt;/script&gt;&#xD;&#xA;  &lt;style&gt;&#xD;&#xA;    /* Styles for the form and preview */&#xD;&#xA;    body {&#xD;&#xA;      font-family: Arial, sans-serif;&#xD;&#xA;      margin: 10px;&#xD;&#xA;      padding: 0;&#xD;&#xA;      color:black;&#xD;&#xA;      &#xD;&#xA;    }&#xD;&#xA;    .container1 {&#xD;&#xA;    width: 530px;&#xD;&#xA;      margin: auto;&#xD;&#xA;    &#xD;&#xA;      padding: 5px;&#xD;&#xA;      border-radius: 8px;&#xD;&#xA;      color:black;&#xD;&#xA;      box-shadow: 1px 1px 6px 1px #753fa9;&#xD;&#xA;    }&#xD;&#xA;    #title{text-align: center;&#xD;&#xA;      background-color: #753fa9;&#xD;&#xA;      color: #fff; &#xD;&#xA;      border-radius: 8px;&#xD;&#xA;    }&#xD;&#xA;    form {&#xD;&#xA;      margin-bottom: 30px;&#xD;&#xA;    }&#xD;&#xA;    label {&#xD;&#xA;      display: block;&#xD;&#xA;      margin-bottom: 5px;&#xD;&#xA;    }&#xD;&#xA;    input:focus {&#xD;&#xA;  background-color: #753fa9;&#xD;&#xA;  color: white;&#xD;&#xA; &#xD;&#xA;  box-shadow: 1px 1px 6px 1px #753fa9;&#xD;&#xA;}&#xD;&#xA;    input[type=&#34;text&#34;], #ifsc, input[type=&#34;number&#34;],&#xD;&#xA;    textarea {&#xD;&#xA;      width: 95%;&#xD;&#xA;      padding: 8px;&#xD;&#xA;      margin-bottom: 10px;&#xD;&#xA;      border-radius: 4px;&#xD;&#xA;      font-weight:900;&#xD;&#xA;      border: 1px solid #black;&#xD;&#xA;      &#xD;&#xA;      &#xD;&#xA;    }&#xD;&#xA;    &#xD;&#xA;    input[type=&#34;file&#34;] {&#xD;&#xA;      margin-bottom: 20px;&#xD;&#xA;      font-size: 20px;&#xD;&#xA;      width:95%;&#xD;&#xA;     &#xD;&#xA;    }&#xD;&#xA;    input[type=&#34;submit&#34;] {&#xD;&#xA;      background-color: #753fa9;&#xD;&#xA;      color: #fff;&#xD;&#xA;      border: none;&#xD;&#xA;      padding: 10px 20px;&#xD;&#xA;      border-radius: 4px;&#xD;&#xA;      cursor: pointer;&#xD;&#xA;      width: 100%;&#xD;&#xA;      font-size: 22px;&#xD;&#xA;      font-weight: 700;&#xD;&#xA;    }&#xD;&#xA;    input[type=&#34;submit&#34;]:hover {&#xD;&#xA;      background-color: #754f61;&#xD;&#xA;    }&#xD;&#xA;    .photo {&#xD;&#xA;      width: 80px;&#xD;&#xA;  height:120;&#xD;&#xA;      height: auto;&#xD;&#xA;      display: block;&#xD;&#xA;      margin-bottom: 30px;&#xD;&#xA;    }&#xD;&#xA;    .preview-section {&#xD;&#xA;      display: none;&#xD;&#xA;      z-index: -2;&#xD;&#xA;&#xD;&#xA;    }&#xD;&#xA;    .preview-section.active {&#xD;&#xA;      display: block;&#xD;&#xA;    }&#xD;&#xA;    table {&#xD;&#xA;      width: auto;&#xD;&#xA;      border-collapse: collapse;&#xD;&#xA;      margin-bottom: 2px;&#xD;&#xA;       padding: 2px;&#xD;&#xA;        text-align: left;&#xD;&#xA;        font-size: 11px;&#xD;&#xA;&#xD;&#xA;    }&#xD;&#xA;    td, th {text-align: left;}&#xD;&#xA;    &#xD;&#xA;    #previewPhoto {&#xD;&#xA;      padding: 3px;&#xD;&#xA;  position: absolute;&#xD;&#xA;  top: 50px;&#xD;&#xA;  right: 5px;&#xD;&#xA;  width: 90px;&#xD;&#xA;  height:120;&#xD;&#xA;  border-bottom:2px solid #753fa9;&#xD;&#xA;  border-left: 2px solid #753fa9;&#xD;&#xA;  border-top: 2px solid #cc0000;&#xD;&#xA;  border-right:2px solid #cc0000;&#xD;&#xA;  border-radius: 10px;}&#xD;&#xA;  .passbook {&#xD;&#xA;background-color: white;&#xD;&#xA;color:black;&#xD;&#xA; position: relative;&#xD;&#xA;  margin-top: 50px;&#xD;&#xA;  margin-bottom: 20px;&#xD;&#xA;  margin: auto;&#xD;&#xA;  layout: fixed;&#xD;&#xA;line-height: 1.4;&#xD;&#xA;  height: 250px;&#xD;&#xA;  background-repeat: no-repeat;&#xD;&#xA;  paddig:10px;&#xD;&#xA;  border-bottom:2px solid #753fa9;&#xD;&#xA;  border-left: 2px solid #753fa9;&#xD;&#xA;  border-top: 2px solid #cc0000;&#xD;&#xA;  border-right:2px solid #cc0000;&#xD;&#xA;&#xD;&#xA;  border-radius: 10px;&#xD;&#xA;&#xD;&#xA;}&#xD;&#xA;#headphoto { width:80%; &#xD;&#xA;&#xD;&#xA;margin-left:20px;&#xD;&#xA;&#xD;&#xA;    }&#xD;&#xA;&#xD;&#xA;#bg-img {&#xD;&#xA;  position: absolute;&#xD;&#xA;  z-index: 1;&#xD;&#xA;  margin-top: 50px;&#xD;&#xA;  margin-left:100px;&#xD;&#xA;  height: 160px;&#xD;&#xA;opacity: 60%;}&#xD;&#xA;   &#xD;&#xA;     button {&#xD;&#xA;    width: 20%;&#xD;&#xA;    border: none;&#xD;&#xA;    border-radius: 8px;&#xD;&#xA;    font-weight: 700;&#xD;&#xA;    color: white;&#xD;&#xA;   margin-top: 5px;&#xD;&#xA;   margin-left: 30px;&#xD;&#xA;    font-size:20px;&#xD;&#xA;  }&#xD;&#xA;     button:hover{opacity:60%;&#xD;&#xA;    }&#xD;&#xA; .edit { &#xD;&#xA; background-color: orange;&#xD;&#xA;&#xD;&#xA;  }&#xD;&#xA;  &#xD;&#xA;  .reload {&#xD;&#xA;   background-color: red;&#xD;&#xA;  }&#xD;&#xA;  &#xD;&#xA;  .print {&#xD;&#xA;   background-color: green;&#xD;&#xA;  }&#xD;&#xA;    &#xD;&#xA;    &#xD;&#xA;       .cut {&#xD;&#xA;  border:1px dashed darkcyan;&#xD;&#xA;  padding: 5px;&#xD;&#xA;   margin: auto;&#xD;&#xA;   max-width: 400px;&#xD;&#xA;&#xD;&#xA; }&#xD;&#xA;&#xD;&#xA;#note {&#xD;&#xA;  margin-top: 10px;&#xD;&#xA;  font-size: 6px;&#xD;&#xA;  display:none;&#xD;&#xA;&#xD;&#xA;border: 0.2px solid;&#xD;&#xA;padding: 5px;&#xD;&#xA;border-radius: 5px;&#xD;&#xA;&#xD;&#xA;}&#xD;&#xA;.left{ float: left; &#xD;&#xA;width: 48%;&#xD;&#xA;margin-left: 1px;}&#xD;&#xA;.right{ float: right;&#xD;&#xA;  width: 48%;&#xD;&#xA;  margin-right: 3px;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;@media only screen and (max-width: 600px) {&#xD;&#xA;  .container1 {&#xD;&#xA;    width: 350px;&#xD;&#xA;      margin: auto;&#xD;&#xA;     &#xD;&#xA;      padding: 5px;&#xD;&#xA;      border-radius: 8px;&#xD;&#xA;      box-shadow: 1px 1px 6px 1px #753fa9;&#xD;&#xA;    }&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;  .passbook {&#xD;&#xA;background-color: white;&#xD;&#xA;color:black;&#xD;&#xA; position: relative;&#xD;&#xA;  margin-top: 50px;&#xD;&#xA;  margin-bottom: 20px;&#xD;&#xA;  margin: auto;&#xD;&#xA;  layout: fixed;&#xD;&#xA;line-height: 1.4;&#xD;&#xA;  height: 230px;&#xD;&#xA; &#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;  #previewPhoto {&#xD;&#xA;      padding: 3px;&#xD;&#xA;  position: absolute;&#xD;&#xA;  top: 50px;&#xD;&#xA;  right: 5px;&#xD;&#xA;  width: 70px;&#xD;&#xA;  height:100;&#xD;&#xA;  border-bottom:2px solid #753fa9;&#xD;&#xA;  border-left: 2px solid #753fa9;&#xD;&#xA;  border-top: 2px solid #cc0000;&#xD;&#xA;  border-right:2px solid #cc0000;&#xD;&#xA;&#xD;&#xA;  border-radius: 10px;}&#xD;&#xA;  &#xD;&#xA;  &#xD;&#xA;        &#xD;&#xA;        &#xD;&#xA;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;@media only screen and (max-width: 380px) {&#xD;&#xA;  .container1 {&#xD;&#xA;    width: 320px;&#xD;&#xA;      margin: auto;&#xD;&#xA;     &#xD;&#xA;      padding: 5px;&#xD;&#xA;      border-radius: 8px;&#xD;&#xA;      box-shadow: 1px 1px 6px 1px #753fa9;&#xD;&#xA;    }&#xD;&#xA;  #previewPhoto {&#xD;&#xA;      padding: 3px;&#xD;&#xA;  position: absolute;&#xD;&#xA;  top: 50px;&#xD;&#xA;  right: 5px;&#xD;&#xA;  width: 70px;&#xD;&#xA;  height:100;&#xD;&#xA; border-bottom:2px solid #753fa9;&#xD;&#xA;  border-left: 2px solid #753fa9;&#xD;&#xA;  border-top: 2px solid #cc0000;&#xD;&#xA;  border-right:2px solid #cc0000;&#xD;&#xA;&#xD;&#xA;  border-radius: 10px;&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;}&#xD;&#xA;  &#xD;&#xA;  .passbook {&#xD;&#xA;background-color: white;&#xD;&#xA;color:black;&#xD;&#xA; position: relative;&#xD;&#xA;  margin-top: 50px;&#xD;&#xA;  margin-bottom: 20px;&#xD;&#xA;  margin: auto;&#xD;&#xA;  layout: fixed;&#xD;&#xA;line-height: 1.4;&#xD;&#xA;  height: 230px;&#xD;&#xA; &#xD;&#xA;}&#xD;&#xA;        &#xD;&#xA;        .left{ float: none; &#xD;&#xA;        width: 95%;}&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;.right{ float: none;&#xD;&#xA;  width: 95%;&#xD;&#xA; &#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;}&#xD;&#xA;    &#xD;&#xA;      @media print {&#xD;&#xA;      /* Hide header when printing */&#xD;&#xA;      .button, #note {&#xD;&#xA;        display: none;&#xD;&#xA;        background-color: #fff;&#xD;&#xA;      }&#xD;&#xA;       .container1 {&#xD;&#xA;  color:black;&#xD;&#xA;       box-shadow: 1px 1px 6px 1px #fff;&#xD;&#xA;    }&#xD;&#xA;     &#xD;&#xA;     &#xD;&#xA;    } &#xD;&#xA;&#xD;&#xA;  &lt;/style&gt;&#xD;&#xA;&#xD;&#xA;&lt;/head&gt;&#xD;&#xA;&lt;body&gt;&#xD;&#xA;  &#xD;&#xA;  &lt;div class=&#34;container1&#34;&gt;&#xD;&#xA;    &#xD;&#xA;    &lt;form id=&#34;resumeForm&#34; onsubmit=&#34;preview(event)&#34;&gt;&#xD;&#xA;      &lt;h1 id=&#34;title&#34;&gt;Fino Identity Card &lt;/h1&gt;&#xD;&#xA;      &lt;div class=&#34;left&#34;&gt;&#xD;&#xA;      &lt;label for=&#34;CifNumber&#34;&gt;Customer ID:&lt;/label&gt;&#xD;&#xA;      &lt;input type=&#34;text&#34; id=&#34;CifNumber&#34; name=&#34;CifNumber&#34; placeholder=&#34;Enter Customer Id&#34; maxlength=&#34;11&#34;&gt;&#xD;&#xA;      &#xD;&#xA;      &lt;label for=&#34;account&#34;&gt;Account Number:&lt;/label&gt;&#xD;&#xA;      &lt;input type=&#34;text&#34; id=&#34;account&#34; name=&#34;account&#34;  placeholder=&#34;Enter Account Number&#34; maxlength=&#34;11&#34; required &gt;&#xD;&#xA;           &lt;label for=&#34;confirm_account&#34;&gt;Confirm Account:&lt;/label&gt;&#xD;&#xA;    &lt;input type=&#34;number&#34; id=&#34;confirm_account&#34; name=&#34;confirm_account&#34; required placeholder=&#34;Confirm Account Number&#34;&gt;&#xD;&#xA;      &#xD;&#xA;      &lt;label for=&#34;ifsc&#34;&gt;IFSC Code:&lt;/label&gt;&#xD;&#xA;      &lt;select id=&#34;ifsc&#34; name=&#34;ifsc&#34;&gt;&#xD;&#xA;    &lt;option value=&#34;FINO0000001&#34;&gt;FINO0000001&lt;/option&gt;&#xD;&#xA;    &lt;option value=&#34;FINO0001446&#34;&gt;FINO0001446&lt;/option&gt;&#xD;&#xA;    &lt;option value=&#34;FINO0009003&#34;&gt;FINO0009003&lt;/option&gt;&#xD;&#xA;    &lt;option value=&#34;FINO0001561&#34;&gt;FINO0001561&lt;/option&gt;&#xD;&#xA;  &lt;/select&gt;&#xD;&#xA;      &lt;label for=&#34;Customer&#34;&gt;Customer Name:&lt;/label&gt;&#xD;&#xA;      &lt;input type=&#34;text&#34; id=&#34;Customer&#34; name=&#34;Customer&#34; placeholder=&#34;Enter Customer Number&#34; required&gt;&#xD;&#xA;      &lt;label for=&#34;Perent&#34;&gt;Father/Husbend:&lt;/label&gt;&#xD;&#xA;      &lt;input type=&#34;text&#34; id=&#34;Perent&#34; name=&#34;Perent&#34; placeholder=&#34;Enter Perent Number&#34;&gt;&#xD;&#xA;&#xD;&#xA;     &#xD;&#xA;      &lt;/div&gt;&#xD;&#xA;      &lt;div class=&#34;right&#34;&gt;&#xD;&#xA;              &lt;label for=&#34;mobile&#34;&gt;Mobile Number:&lt;/label&gt;&#xD;&#xA;      &lt;input type=&#34;text&#34; id=&#34;mobile&#34; name=&#34;mobile&#34; maxlength=&#34;10&#34; placeholder=&#34;Enter Mobile Number&#34;&gt;&#xD;&#xA;         &lt;label for=&#34;aadhar&#34;&gt;UID Number:&lt;/label&gt;&#xD;&#xA;      &lt;input type=&#34;text&#34; id=&#34;aadhar&#34; name=&#34;aadhar&#34; maxlength=&#34;14&#34; oninput=&#34;formatNumber(this)&#34; placeholder=&#34;Enter Aadhar Number&#34;&gt;&#xD;&#xA;      &lt;label for=&#34;Address&#34;&gt;Address:&lt;/label&gt;&#xD;&#xA;      &lt;input type=&#34;text&#34; id=&#34;Address&#34; name=&#34;Address&#34; rows=&#34;1&#34;  placeholder=&#34;Enter Customer Full Address&#34;&gt;      &lt;label for=&#34;Pincode&#34;&gt;Pin Code:&lt;/label&gt;&#xD;&#xA;      &lt;input type=&#34;text&#34; id=&#34;Pincode&#34; name=&#34;Pincode&#34;  placeholder=&#34;Enter Pincode Number&#34; maxlength=&#34;6&#34;&gt;&#xD;&#xA;      &#xD;&#xA;      &lt;label for=&#34;KoName&#34;&gt;Kiosk Name:&lt;/label&gt;&#xD;&#xA;      &lt;input type=&#34;text&#34; id=&#34;KoName&#34; name=&#34;KoName&#34;  placeholder=&#34;Enter Kiosk Name&#34;&gt;&#xD;&#xA;      &lt;label for=&#34;Location&#34;&gt;Kiosk Location:&lt;/label&gt;&#xD;&#xA;      &lt;input type=&#34;text&#34; id=&#34;Location&#34; name=&#34;Location&#34;  placeholder=&#34;Enter Location Name&#34;&gt;&#xD;&#xA;    &#xD;&#xA;      &#xD;&#xA;&#xD;&#xA;      &lt;/div&gt;&#xD;&#xA;      &lt;label for=&#34;photo&#34;&gt;Upload Photo:&lt;/label&gt;&#xD;&#xA;      &lt;input type=&#34;file&#34; id=&#34;photo&#34; name=&#34;photo&#34; accept=&#34;image/*&#34;&gt;&#xD;&#xA;      &lt;input type=&#34;submit&#34; value=&#34;Generate Identity Card&#34; onclick =&#34;return checkAccount()&#34;&gt;&#xD;&#xA;    &lt;/form&gt;&#xD;&#xA;&#xD;&#xA;    &lt;div class=&#34;preview-section&#34; id=&#34;previewSection&#34;&gt;&#xD;&#xA;       &lt;div class=&#34;cut&#34;&gt;&#xD;&#xA;      &lt;div class=&#34;passbook&#34;&gt;&#xD;&#xA;        &lt;div  style=&#34;clear: both;&#34;&gt;&#xD;&#xA;        &lt;img id=&#34;bg-img&#34; src=&#34;https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEiqKKsEnHyOl-Jc2uQmJ7qBFeEGmxzajEuSKY2MS8kxagAZbuwhRg4DyCf7bbUMDT_uAs9irWor3KqhwPCRjERdWN5PQjqfKWObGkSqLQVyOEl2uTXyED7w1roaslYpGdaF6PAiW7FE5CUKFR67KyPl3qJeJ4J2qk5mJfUyNezye3hw1OR0WUiKOcXX3Q/s1000/Fino-Logo.webp&#34;&gt;&lt;/div&gt;&#xD;&#xA;      &lt;div&gt;&#xD;&#xA;     &lt;div id=&#34;photo&#34;&gt; &lt;img id=&#34;previewPhoto&#34; class=&#34;photo&#34; src=&#34;&#34; alt=&#34;Paste Photo&#34; &gt; &lt;/div&gt;&#xD;&#xA;      &lt;img id=&#34;headphoto&#34; src=&#34;https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEjJzswpJsvnqDzNevBAX7iyE3705VGA0fT7B8RQqg3jJ36n-iE_fFZyWdlojF-88Wu9n-44b9RUiJiVeigzRfH6LlYWwc-Zm9bOeQGvaMfZ6lA793DOyqzevtyEuZA-7DMCKod_zu2cVBD2SaG6QrR3zO-tgvz4oCcUOoSGMCOwn06ZT_M583c4MAsiBA/s900/Fino-Head.webp&#34; alt=&#34;Heading Photo&#34; &gt;&#xD;&#xA;       &#xD;&#xA;      &lt;table id=&#34;previewTable&#34;&gt;&lt;/table&gt;&#xD;&#xA;&#xD;&#xA;&lt;/div&gt;&#xD;&#xA;         &lt;/div&gt;&lt;/div&gt;&#xD;&#xA;&lt;div class=&#34;button&#34;&gt;&#xD;&#xA;&#xD;&#xA;&lt;button  class=&#34;reload&#34; onclick=&#34;location.reload();&#34;&gt; Reset &lt;i class=&#34;fa fa-refresh&#34; style=&#34;font-size:11px;color:white&#34; &gt;&lt;/i&gt;&lt;/button&gt;&#xD;&#xA;  &lt;button class=&#34;edit&#34; onclick=&#39;editInfo()&#39;&gt;Edit &lt;i class=&#34;fa fa-edit&#34; style=&#34;font-size:11px;color:black&#34;&gt;&lt;/i&gt;&lt;/button&gt;&#xD;&#xA;   &lt;button class=&#34;print&#34; onclick=&#34;window.print()&#34;&gt;Print &lt;i class=&#34;fa fa-print&#34; style=&#34;font-size:11px;color:white&#34;&gt;&lt;/i&gt;&lt;/button&gt;&#xD;&#xA;     &#xD;&#xA;   &#xD;&#xA;&lt;/div&gt;&#xD;&#xA;      &#xD;&#xA;      &lt;br&gt;&#xD;&#xA;&lt;div id=&#34;note&#34;&gt;&lt;b&gt;Disclaimer: &lt;/b&gt; Note, these passbook kiosks are not printed from the official site of the bank, they are typed manually. Hence, it is possible to find mistakes, which you should match yourself. We do not save any of your data in any format. &lt;/div&gt;&#xD;&#xA;  &lt;script&gt;&#xD;&#xA;    function preview(event) {&#xD;&#xA;      event.preventDefault();&#xD;&#xA;&#xD;&#xA;      const formData = {&#xD;&#xA;        CifNumber: document.getElementById(&#39;CifNumber&#39;).value,&#xD;&#xA;        account: document.getElementById(&#39;account&#39;).value,&#xD;&#xA;        ifsc: document.getElementById(&#39;ifsc&#39;).value,&#xD;&#xA;        Customer: document.getElementById(&#39;Customer&#39;).value,&#xD;&#xA;        Perent: document.getElementById(&#39;Perent&#39;).value,&#xD;&#xA;        mobile: document.getElementById(&#39;mobile&#39;).value,&#xD;&#xA;        aadhar: document.getElementById(&#39;aadhar&#39;).value,&#xD;&#xA;          Address: document.getElementById(&#39;Address&#39;).value,&#xD;&#xA;            Pincode: document.getElementById(&#39;Pincode&#39;).value,&#xD;&#xA;              KoName: document.getElementById(&#39;KoName&#39;).value,&#xD;&#xA;              Location: document.getElementById(&#39;Location&#39;).value,&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;        photo: document.getElementById(&#39;photo&#39;).files[0]&#xD;&#xA;      };&#xD;&#xA;&#xD;&#xA;      // Display the preview section&#xD;&#xA;      document.getElementById(&#39;previewSection&#39;).classList.add(&#39;active&#39;);&#xD;&#xA;&#xD;&#xA;// Display the photo in the preview&#xD;&#xA;      if (formData.photo) {&#xD;&#xA;        const reader = new FileReader();&#xD;&#xA;        reader.onload = function(event) {&#xD;&#xA;          const img = document.getElementById(&#39;previewPhoto&#39;);&#xD;&#xA;          img.src = event.target.result;&#xD;&#xA;        };&#xD;&#xA;        reader.readAsDataURL(formData.photo);&#xD;&#xA;      }&#xD;&#xA;&#xD;&#xA;      // Display the form data in a table in the preview&#xD;&#xA;      const previewTable = document.getElementById(&#39;previewTable&#39;);&#xD;&#xA;      previewTable.innerHTML = `&#xD;&#xA;        &lt;tr&gt;&lt;td&gt;Cif Number:&lt;/td&gt;&lt;th&gt;${formData.CifNumber}&lt;/th&gt;&lt;/tr&gt;&#xD;&#xA;        &lt;tr&gt;&lt;td&gt;Account Number:&lt;/td&gt;&lt;th&gt;${formData.account}&lt;/th&gt;&lt;/tr&gt;&#xD;&#xA;        &lt;tr&gt;&lt;td&gt;IFSC Code:&lt;/th&gt;&lt;th id=&#34;fpbifscOut&#34;&gt;${formData.ifsc}&lt;/th&gt;&lt;/tr&gt;&#xD;&#xA;        &lt;tr&gt;&lt;td&gt;Customer Name:&lt;/td&gt;&lt;th&gt;${formData.Customer}&lt;/th&gt;&lt;/tr&gt;&#xD;&#xA;        &lt;tr&gt;&lt;td&gt;Father/Husband:&lt;/td&gt;&lt;th&gt;${formData.Perent}&lt;/th&gt;&lt;/tr&gt;&#xD;&#xA;         &lt;tr&gt;&lt;td&gt;Mobile Number:&lt;/td&gt;&lt;th&gt;${formData.mobile}&lt;/th&gt;&lt;/tr&gt;&#xD;&#xA;        &lt;tr&gt;&lt;td&gt;UID Number:&lt;/td&gt;&lt;th&gt;${formData.aadhar}&lt;/th&gt;&lt;/tr&gt;&#xD;&#xA;        &lt;tr&gt;&lt;td&gt;Address:&lt;/td&gt;&lt;th&gt;${formData.Address}&lt;/th&gt;&lt;/tr&gt;&#xD;&#xA;        &lt;tr&gt;&lt;td&gt;Pin Code:&lt;/td&gt;&lt;th&gt;${formData.Pincode}&lt;/th&gt;&lt;/tr&gt;&#xD;&#xA;         &lt;tr&gt;&lt;td&gt;Kiosk Name:&lt;/td&gt;&lt;th id=&#34;fpbkoNameOut&#34;&gt;${formData.KoName}&lt;/th&gt;&lt;/tr&gt;&#xD;&#xA;        &lt;tr&gt;&lt;td&gt;Kiosk Location:&lt;/td&gt;&lt;th id=&#34;fpblocationOut&#34;&gt;${formData.Location}&lt;/th&gt;&lt;/tr&gt;&#xD;&#xA;      `;&#xD;&#xA;       // Show the preview section&#xD;&#xA;      document.getElementById(&#39;previewSection&#39;).style.display = &#39;block&#39;;&#xD;&#xA;      // Hide the form&#xD;&#xA;      document.getElementById(&#39;resumeForm&#39;).style.display = &#39;none&#39;;&#xD;&#xA;    }&#xD;&#xA;    &#xD;&#xA;    function editInfo() {&#xD;&#xA;      document.getElementById(&#39;previewSection&#39;).style.display = &#39;none&#39;;&#xD;&#xA;      document.getElementById(&#39;resumeForm&#39;).style.display = &#39;block&#39;;&#xD;&#xA;    }&#xD;&#xA;&#xD;&#xA;    function formatNumber(input) {&#xD;&#xA;            // Remove any existing spaces and non-numeric characters&#xD;&#xA;            var cleanInput = input.value.replace(/\D/g, &#39;&#39;);&#xD;&#xA;&#xD;&#xA;            // Add space after every 3 digits&#xD;&#xA;            var formattedInput = cleanInput.replace(/(\d{4})/g, &#39;$1 &#39;).trim();&#xD;&#xA;&#xD;&#xA;            // Update the input field with the formatted value&#xD;&#xA;            input.value = formattedInput;&#xD;&#xA;        }&#xD;&#xA;&#xD;&#xA;  &lt;/script&gt;&#xD;&#xA;  &lt;script&gt;&#xD;&#xA;const STORAGE_KEY = &#34;kioskData&#34;;&#xD;&#xA;&#xD;&#xA;// IDs EXACTLY as HTML&#xD;&#xA;const fields = [&#34;ifsc&#34;, &#34;KoName&#34;, &#34;Location&#34;];&#xD;&#xA;&#xD;&#xA;// Auto save on typing&#xD;&#xA;fields.forEach(id =&gt; {&#xD;&#xA;    const el = document.getElementById(id);&#xD;&#xA;    if (el) {&#xD;&#xA;        el.addEventListener(&#34;input&#34;, saveData);&#xD;&#xA;    }&#xD;&#xA;});&#xD;&#xA;&#xD;&#xA;function saveData() {&#xD;&#xA;    const data = {&#xD;&#xA;        ifsc: document.getElementById(&#34;ifsc&#34;).value,&#xD;&#xA;        KoName: document.getElementById(&#34;KoName&#34;).value,&#xD;&#xA;        Location: document.getElementById(&#34;Location&#34;).value&#xD;&#xA;    };&#xD;&#xA;&#xD;&#xA;    localStorage.setItem(STORAGE_KEY, JSON.stringify(data));&#xD;&#xA;&#xD;&#xA;    // Update preview only if exists&#xD;&#xA;    if (document.getElementById(&#34;ifscOut&#34;)) {&#xD;&#xA;        updatePreview(data);&#xD;&#xA;    }&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;function loadData() {&#xD;&#xA;    const saved = localStorage.getItem(STORAGE_KEY);&#xD;&#xA;    if (!saved) return;&#xD;&#xA;&#xD;&#xA;    const data = JSON.parse(saved);&#xD;&#xA;&#xD;&#xA;    document.getElementById(&#34;ifsc&#34;).value = data.ifsc || &#34;&#34;;&#xD;&#xA;    document.getElementById(&#34;KoName&#34;).value = data.KoName || &#34;&#34;;&#xD;&#xA;    document.getElementById(&#34;Location&#34;).value = data.Location || &#34;&#34;;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;function updatePreview(data) {&#xD;&#xA;    document.getElementById(&#34;fpbifscOut&#34;).innerText = data.ifsc || &#34;&#34;;&#xD;&#xA;    document.getElementById(&#34;fpbkoNameOut&#34;).innerText = data.KoName || &#34;&#34;;&#xD;&#xA;    document.getElementById(&#34;fpblocationOut&#34;).innerText = data.Location || &#34;&#34;;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;// Page refresh ke time auto fill&#xD;&#xA;window.addEventListener(&#34;DOMContentLoaded&#34;, loadData);&#xD;&#xA;&lt;/script&gt;&#xD;&#xA;&#xD;&#xA;&lt;/body&gt;&#xD;&#xA;&lt;/html&gt;</description>
